{
  "name": "duckhunt-runner",
  "version": "0.4.1",
  "description": "Local daemon for duckhunt agent runs: claims runs and launches Claude Code headless on your own machine, with your login, your repos and your AWS CLI.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "miermontoto",
  "homepage": "https://github.com/miermontoto/duckhunt-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miermontoto/duckhunt-runner.git"
  },
  "bugs": {
    "url": "https://github.com/miermontoto/duckhunt-runner/issues"
  },
  "keywords": [
    "duckhunt",
    "claude-code",
    "agent",
    "daemon",
    "cli"
  ],
  "bin": {
    "duckhunt-runner": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
