{
  "capabilities": [
    "prompt",
    "toolset_v1"
  ],
  "awsDefault": true,
  "toolset": {
    "v": 1,
    "shell": "none",
    "fsWrite": false,
    "memory": false,
    "web": false,
    "vcsPush": true,
    "grants": [
      {
        "type": "repo",
        "key": "org/api",
        "access": "read"
      }
    ],
    "platformTools": [
      "duckhunt-entry-get",
      "duckhunt-entry-list",
      "duckhunt-entry-comments",
      "duckhunt-search",
      "duckhunt-list-monitors",
      "duckhunt-target-get",
      "duckhunt-code-commits",
      "duckhunt-code-diff",
      "duckhunt-note-list",
      "duckhunt-agent-run-get",
      "duckhunt-run-reply",
      "duckhunt-ask-user",
      "duckhunt-entry-suggestions",
      "duckhunt-pipeline-status",
      "duckhunt-doc-guide",
      "duckhunt-atlas-get",
      "duckhunt-agent-message",
      "duckhunt-agent-sessions",
      "duckhunt-openobserve-search",
      "duckhunt-openobserve-trace",
      "duckhunt-run-propose-edit"
    ]
  },
  "tools": {
    "allowed": [
      "Read",
      "Grep",
      "Glob",
      "mcp__duckhunt__duckhunt-entry-get",
      "mcp__duckhunt__duckhunt-entry-list",
      "mcp__duckhunt__duckhunt-entry-comments",
      "mcp__duckhunt__duckhunt-search",
      "mcp__duckhunt__duckhunt-list-monitors",
      "mcp__duckhunt__duckhunt-target-get",
      "mcp__duckhunt__duckhunt-code-commits",
      "mcp__duckhunt__duckhunt-code-diff",
      "mcp__duckhunt__duckhunt-note-list",
      "mcp__duckhunt__duckhunt-agent-run-get",
      "mcp__duckhunt__duckhunt-run-reply",
      "mcp__duckhunt__duckhunt-ask-user",
      "mcp__duckhunt__duckhunt-entry-suggestions",
      "mcp__duckhunt__duckhunt-pipeline-status",
      "mcp__duckhunt__duckhunt-doc-guide",
      "mcp__duckhunt__duckhunt-atlas-get",
      "mcp__duckhunt__duckhunt-agent-message",
      "mcp__duckhunt__duckhunt-agent-sessions",
      "mcp__duckhunt__duckhunt-openobserve-search",
      "mcp__duckhunt__duckhunt-openobserve-trace",
      "mcp__duckhunt__duckhunt-run-propose-edit"
    ],
    "disallowed": [
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Edit",
      "Write",
      "Bash",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.duckhunt-runner.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(//tmp/duckhunt-runner-*)",
      "Read(~/.codex/auth.json)",
      "Read(~/.codex/sessions/**)",
      "Read(~/.codex/history.jsonl)",
      "Read(~/.codex/session_index.jsonl)",
      "Read(~/.codex/thread_history_*.sqlite)",
      "Read(~/.local/share/opencode/**)",
      "Read(~/.config/opencode/**)",
      "Read(~/.config/amp/settings.json)",
      "Read(~/.config/amp/settings.jsonc)",
      "Read(~/.local/share/amp/secrets.json)",
      "Read(~/.gemini/oauth_creds.json)",
      "Read(~/.gemini/google_accounts.json)",
      "Read(~/.copilot/config.json)",
      "Read(~/.config/goose/secrets.yaml)",
      "Read(~/.config/goose/sessions/**)",
      "Read(~/.local/share/goose/**)",
      "Read(~/.cursor/cli-config.json)",
      "Read(~/.claude/projects/**/*.jsonl)"
    ]
  },
  "permissionMode": "dontAsk",
  "mcpServerName": "duckhunt"
}
